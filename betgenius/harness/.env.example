# Phase 1 MLB backtest harness — environment.
# Copy this file to `harness/.env` and fill in the values. `.env` is git-ignored
# and must never be committed, pasted into a chat, or attached to a ticket.

# ---------------------------------------------------------------------------
# REQUIRED to pull data. Not needed to re-run the analysis from the cached
# dumps in harness/uplift/data, which is what the Python pipeline reads.
# ---------------------------------------------------------------------------

# Postgres connection string for the READ-ONLY `harness_readonly` role.
# SELECT only; the role has a connection limit of 10, so never run two Deno
# backtests at once. Source: the project owner, in a private channel.
HARNESS_DATABASE_URL=postgresql://harness_readonly.<project>:<password>@<host>:5432/postgres?sslmode=require

# The Odds API key, historical endpoint. Used only by
# harness/uplift/ingest_odds_api.ts, for the two markets the warehouse never
# held (batter_runs_scored, batter_strikeouts) and the pitcher_outs window after
# 2025-05-28. Source: https://the-odds-api.com/account/
ODDS_API_KEY=<the-odds-api-key>

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Supabase's public root certificate, needed by Deno or every connection fails
# with "certificate is invalid". Not a secret; fetch it once:
#   curl -o prod-ca-2021.crt https://supabase-downloads.s3.amazonaws.com/prod/ssl/prod-ca-2021.crt
# then, from betgenius/:  export DENO_CERT="$PWD/prod-ca-2021.crt"
# (PowerShell: $env:DENO_CERT = "$PWD\prod-ca-2021.crt")
DENO_CERT=<absolute path to prod-ca-2021.crt>

# Where build_cache.py writes its walk-forward caches. Defaults to
# harness/uplift/cache. Set it to build a second feature set side by side,
# which is what attribute.py compares against.
UPLIFT_CACHE_DIR=
