prod-ca-2021.crt

# --- uplift working set ------------------------------------------------------
# Raw dumps and walk-forward caches are rebuildable from the read-only database
# and The Odds API in minutes (see harness/uplift/README.md); they are hundreds
# of megabytes and are deliberately not in the repo.
betgenius/harness/uplift/data/
betgenius/harness/uplift/cache/
betgenius/harness/uplift/cache_v1/
betgenius/harness/uplift/reports/picks_*.csv
betgenius/harness/uplift/__pycache__/
__pycache__/
*.pyc

# --- editor ------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

