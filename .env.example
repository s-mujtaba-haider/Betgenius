# =============================================================================
# SharpAI / BetGenius — every environment variable the repository actually reads
# =============================================================================
# This file is a TEMPLATE. It contains placeholders only and is safe to commit.
# Real values never go in the repository. They live in three places:
#
#   frontend (Vite)     betgenius/.env.local          git-ignored, and in Vercel
#   edge functions      `supabase secrets set NAME=…`  never on disk
#   backtest harness    betgenius/harness/.env         git-ignored
#
# Verify what an edge function can see with:  supabase secrets list
# Verify the frontend picked its values up:   npm run build  (it fails loudly on
#                                             a missing VITE_SUPABASE_* — see
#                                             src/lib/supabase.ts)
#
# Column key below:  [R] required   [O] optional   [S] secret — rotate if leaked
# =============================================================================


# --- Frontend, betgenius/.env.local -----------------------------------------
# Vite inlines anything prefixed VITE_ into the JS bundle, so these are PUBLIC
# by design. The anon key is meant to be public; it is RLS that protects data.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co          # [R] project API URL
VITE_SUPABASE_ANON_KEY=<supabase-anon-key>                   # [R] public anon key
VITE_SENTRY_DSN_FRONTEND=<sentry-dsn>                        # [O] error reporting


# --- Edge functions, `supabase secrets set` ---------------------------------
# Deno runtime, supabase/functions/**. SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are injected by the platform; the rest you set yourself.

SUPABASE_URL=https://<project-ref>.supabase.co               # [R] injected
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>                 # [R][S] FULL DB ACCESS
SUPABASE_ANON_KEY=<supabase-anon-key>                        # [O] public
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres  # [O][S]
SUPABASE_SECRET_KEYS=<comma-separated>                       # [O][S] key rotation helper

THE_ODDS_API_KEY=<the-odds-api-key>                          # [R][S] odds + lines
BALLDONTLIE_API_KEY=<balldontlie-key>                        # [O][S] NBA/NFL stats
GEMINI_API_KEY=<google-ai-studio-key>                        # [O][S] pick write-ups
ANTHROPIC_API_KEY=<anthropic-key>                            # [O][S] pick write-ups

BACKFILL_AUTH_TOKEN=<shared-secret>                          # [R][S] guards the
  # backfill/admin endpoints. NOTE (D-365): a function that both reads this AND
  # makes outgoing PostgREST calls will 401 if the value is a bare UUID — keep it
  # distinct from any apikey value.

STRIPE_SECRET_KEY=<sk_live_…>                                # [O][S] billing
STRIPE_SECRET_KEY_TEST=<sk_test_…>                           # [O][S]
STRIPE_WEBHOOK_SECRET=<whsec_…>                              # [O][S]
STRIPE_WEBHOOK_SECRET_TEST=<whsec_…>                         # [O][S]

TWILIO_ACCOUNT_SID=<AC…>                                     # [O][S] alerting
TWILIO_AUTH_TOKEN=<token>                                    # [O][S]
TWILIO_FROM_NUMBER=+1XXXXXXXXXX                              # [O]
TWILIO_TO_NUMBER=+1XXXXXXXXXX                                # [O]

SENTRY_DSN_EDGE=<sentry-dsn>                                 # [O]
APP_URL=https://<your-vercel-domain>                         # [O] links in emails


# --- Backtest harness, betgenius/harness/.env -------------------------------
# See betgenius/harness/.env.example for the long-form notes.

HARNESS_DATABASE_URL=postgresql://harness_readonly.<ref>:<password>@<host>:5432/postgres?sslmode=require  # [R][S] SELECT only, conn limit 10
ODDS_API_KEY=<the-odds-api-key>                              # [R][S] historical endpoint
DENO_CERT=<abs path to prod-ca-2021.crt>                     # [O] not a secret
UPLIFT_CACHE_DIR=                                            # [O] alternate cache dir


# --- Set by the platform, never by you --------------------------------------
# VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, MODE — read by the build for version banners
# and environment switches.
